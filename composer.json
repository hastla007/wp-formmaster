{
  "name": "hastla007/form-captain",
  "description": "Form Captain \u2013 WordPress-native forms and submission management.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^3.0",
    "wp-phpunit/wp-phpunit": "^6.8",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.8"
  },
  "autoload": {
    "psr-4": {
      "FormCaptain\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FormCaptain\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.5.0"
    }
  },
  "scripts": {
    "lint": "bin/lint.sh",
    "phpcs": "phpcs",
    "phpstan": "tools/phpstan/vendor/bin/phpstan analyse --memory-limit=1G -c phpstan.neon.dist",
    "test:integration": "phpunit -c phpunit.xml.dist",
    "test:multisite": "phpunit -c phpunit-multisite.xml.dist",
    "test": [
      "@test:integration"
    ]
  }
}
