msgstr "Form-Captain-E-Mails sind kürzlich fehlgeschlagen"

#: src/Admin/SiteHealth.php:95
msgid "Form Captain background processing is scheduled"
msgstr "Form-Captain-Hintergrundverarbeitung ist eingeplant"

#: src/Admin/SiteHealth.php:96
