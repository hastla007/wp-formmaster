<?xml version="1.0"?>
<ruleset name="Form Captain">
	<description>WordPress Coding Standards for Form Captain (PSR-4 file names allowed, see ADR 0001).</description>
	<file>form-captain.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>src</file>
	<file>connectors</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<config name="minimum_wp_version" value="6.8"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Generic.Commenting.DocComment"/>
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.PHP.CommentedOutCode"/>
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Universal.Operators.StrictComparisons"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound"/>
		<exclude name="Squiz.Commenting.FunctionCommentThrowTag"/>
		<!-- Custom tables are accessed exclusively through repositories (ADR 0001). -->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>
	</rule>
	<!-- Repositories build placeholder lists dynamically; values are always passed to prepare(). -->
	<rule ref="WordPress.DB.PreparedSQLPlaceholders.ReplacementsWrongNumber"><exclude-pattern>src/Repository/*</exclude-pattern></rule>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders.UnfinishedPrepare"><exclude-pattern>src/Repository/*</exclude-pattern></rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="form-captain"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="form_captain"/>
				<element value="FormCaptain"/>
				<element value="FORM_CAPTAIN"/>
			</property>
		</properties>
	</rule>
</ruleset>
