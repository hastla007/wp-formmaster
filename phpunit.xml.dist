<?xml version="1.0"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" convertDeprecationsToExceptions="true" beStrictAboutOutputDuringTests="false">
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/integration</directory>
		</testsuite>
	</testsuites>
	<groups>
		<exclude>
			<!-- Multisite tests run in their own run: phpunit -c phpunit-multisite.xml.dist (SET-FC-42). -->
			<group>multisite</group>
		</exclude>
	</groups>
</phpunit>
