{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hastla007/wp-formmaster/schema/form-schema-v1.json",
  "title": "Form Captain form definition v1",
  "type": "object",
  "required": ["schema_version", "fields"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "retired_ids": { "type": "array", "items": { "$ref": "#/$defs/fieldId" }, "maxItems": 1000 },
    "fields": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/field" } }
  },
  "$defs": {
    "fieldId": { "type": "string", "pattern": "^f_[a-z0-9]{6,32}$" },
    "option": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,64}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 190 }
      }
    },
    "condition": {
      "type": ["object", "null"],
      "required": ["action", "field", "operator"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["show", "hide"] },
        "field": { "$ref": "#/$defs/fieldId" },
        "operator": { "enum": ["equals", "not_equals", "contains", "is_empty", "is_not_empty", "checked"] },
        "value": { "type": "string", "maxLength": 190 }
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "type", "key"],
      "properties": {
        "id": { "$ref": "#/$defs/fieldId" },
        "type": { "enum": ["text", "textarea", "email", "tel", "number", "select", "radio", "checkbox", "date", "html", "hidden", "consent"] },
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
        "label": { "type": "string", "maxLength": 190 },
        "required": { "type": "boolean" },
        "help": { "type": "string", "maxLength": 500 },
        "placeholder": { "type": "string", "maxLength": 190 },
        "default": { "type": "string", "maxLength": 500 },
        "css_class": { "type": "string", "pattern": "^[A-Za-z0-9_\\- ]{0,100}$" },
        "sensitive": { "type": "boolean" },
        "options": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/option" } },
        "multiple": { "type": "boolean" },
        "rows": { "type": "integer", "minimum": 2, "maximum": 20 },
        "content": { "type": "string", "maxLength": 20000 },
        "consent_text": { "type": "string", "maxLength": 2000 },
        "privacy_link": { "type": "boolean" },
        "consent_revision": { "type": "integer", "minimum": 1 },
        "privacy_lookup": { "type": "boolean" },
        "confirmation_recipient": { "type": "boolean" },
        "autocomplete": { "enum": ["off", "name", "given-name", "family-name", "honorific-prefix", "organization", "email", "tel", "street-address", "address-line1", "address-line2", "postal-code", "address-level2", "address-level1", "country-name", "bday", "url"] },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_length": { "type": "integer", "minimum": 0 },
            "max_length": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "pattern": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,30}$", "description": "Core: alpha, alnum, zip_de, zip_at, zip_ch, zip_generic, custom; more via form_captain_validation_patterns_v1" },
            "custom_pattern": { "type": "string", "maxLength": 200, "description": "Own regular expression (without delimiters) when pattern = custom; checked against slow constructs" },
            "format": { "enum": ["international"], "description": "Phone fields: + and country code required" },
            "min_age": { "type": "integer", "minimum": 1, "maximum": 120, "description": "Date fields: minimum age in years on the day of submission" },
            "message": { "type": "string", "maxLength": 190, "description": "Own error message of the field; empty = translated default" },
            "min": { "type": "string", "maxLength": 32 },
            "max": { "type": "string", "maxLength": 32 },
            "step": { "type": "string", "maxLength": 32 },
            "min_choices": { "type": "integer", "minimum": 0 },
            "max_choices": { "type": "integer", "minimum": 1 }
          }
        },
        "condition": { "$ref": "#/$defs/condition" }
      }
    }
  }
}
